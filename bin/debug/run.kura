int a = 10;
int b = 5;
int c = 20;
int d = 7;
int result = 0;

if ((a > b) && (c > d)) {

    if ((a + b) > (c - d)) {
        result = 100;
    }
    else if ((a * b) > (c + d)) {
        result = 200;
    }
    else {
        result = 300;
    }

}
else if ((a == 10) || (d < 3)) {

    if ((c / 2) == 0) {
        result = result + 10;
    }
    else {
        result = result + 20;
    }

}
else {

    if (a < 0) {
        result = -1;
    }
    else if (a < 100) {

        if (b > 0) {
            result = 500;
        }
        else {
            result = 600;
        }

    }
    else {
        result = 700;
    }

}

print(result);