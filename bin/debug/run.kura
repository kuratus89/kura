func int sqrtbinary (int x) {
    int left = 0;
    int right = x;
    int ans = 0;

    while (left <= right) {
        int mid = left + (right - left) / 2;

        if (mid * mid <= x) {
            ans = mid;
            left = mid + 1;
        } else {
            right = mid - 1;
        }
    }

    return ans;
}

print sqrtbinary(0);