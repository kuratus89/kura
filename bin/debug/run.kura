int square(int x) {
    return x * x;
}

int work(int n) {
    int sum = 0;

    for (int i = 1; i <= n; i++) {

        if (i % 7 == 0) {
            continue;
        }

        int j = 0;

        while (j < i) {

            if (j == 5) {
                break;
            }

            sum = sum + square(i + j);
            j = j + 1;
        }
    }

    return sum;
}


print(work(10));
